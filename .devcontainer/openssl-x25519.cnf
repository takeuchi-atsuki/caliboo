# ----------------------------------------
# 開発コンテナの通信改善を目的とした設定。
# 
# ## 背景:
# OpenSSL 3.5 では TLS 1.3 の鍵交換方式として
# X25519MLKEM768 が選択される場合がある。
#
# 現在の開発環境では X25519MLKEM768 を使用した場合、
# TLS ハンドシェイクに遅延が発生するため、
# 従来方式の X25519 を使用する。
#
# ネットワーク環境や OpenSSL の改善により解消する可能性があるため、
# 将来的に本設定の見直しを行う。
# ----------------------------------------
openssl_conf = openssl_init

[openssl_init]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
Groups = X25519